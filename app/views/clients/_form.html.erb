<%= form_with(model: client, data: { controller: "client-type" }) do |form| %>
  <% if client.errors.any? %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
      <h3 class="text-red-800 font-semibold mb-2"><%= ru_pluralize(client.errors.count, "ошибка", "ошибки", "ошибок") %>:</h3>
      <ul class="list-disc ml-6 text-red-700 text-sm">
        <% client.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_section "Основная информация" do %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <%= field_wrapper form, :client_type, "Тип клиента *" do %>
        <%= form.select :client_type,
            { "Физическое лицо" => "individual", "ИП" => "entrepreneur", "Юридическое лицо" => "legal_entity" },
            { include_blank: "Выберите тип..." },
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
            data: { client_type_target: "typeSelect", action: "client-type#typeChanged" } %>
      <% end %>

      <%= field_wrapper form, :name, "ФИО / Наименование *" do %>
        <%= form.text_field :name,
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
            placeholder: "Иван Петров / ООО Тепло" %>
      <% end %>

      <%= field_wrapper form, :phone, "Телефон *" do %>
        <%= form.text_field :phone,
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
            placeholder: "+7 (999) 123-45-67" %>
      <% end %>

      <%= field_wrapper form, :email, "Email" do %>
        <%= form.text_field :email,
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
            placeholder: "client@example.com" %>
      <% end %>
    </div>
  <% end %>

  <!-- ФИЗЛИЦО: персональные и паспортные данные -->
  <div data-client-type-target="individualFields">
    <%= form_section "Паспортные данные" do %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <%= field_wrapper form, :gender, "Пол" do %>
          <%= form.select :gender, { "Мужской" => "male", "Женский" => "female" }, { include_blank: "—" },
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
        <% end %>

        <%= field_wrapper form, :birth_date, "Дата рождения" do %>
          <%= form.date_field :birth_date, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
        <% end %>
      </div>

      <%= field_wrapper form, :birth_place, "Место рождения" do %>
        <%= form.text_field :birth_place,
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
            placeholder: "г. Москва" %>
      <% end %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <%= field_wrapper form, :passport_series, "Серия паспорта (4 цифры)" do %>
          <%= form.text_field :passport_series, maxlength: 4,
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
              placeholder: "1234" %>
        <% end %>

        <%= field_wrapper form, :passport_number, "Номер паспорта (6 цифр)" do %>
          <%= form.text_field :passport_number, maxlength: 6,
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
              placeholder: "567890" %>
        <% end %>

        <%= field_wrapper form, :passport_issued_on, "Дата выдачи" do %>
          <%= form.date_field :passport_issued_on, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
        <% end %>

        <%= field_wrapper form, :passport_department_code, "Код подразделения" do %>
          <%= form.text_field :passport_department_code, maxlength: 7,
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
              placeholder: "123-456" %>
        <% end %>
      </div>

      <%= field_wrapper form, :passport_issued_by, "Кем выдан" do %>
        <%= form.text_field :passport_issued_by,
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
            placeholder: "Отделом УФМС России по г. Москве" %>
      <% end %>

      <%= field_wrapper form, :registration_address, "Адрес регистрации (прописка)" do %>
        <%= form.text_area :registration_address, rows: 2,
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
            placeholder: "г. Москва, ул. Ленина, д. 1, кв. 10" %>
      <% end %>
    <% end %>
  </div>

  <!-- ИП / ЮРЛИЦО: гос. реквизиты -->
  <div data-client-type-target="entrepreneurFields">
    <%= form_section "Реквизиты" do %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <%= field_wrapper form, :inn, "ИНН" do %>
          <%= form.text_field :inn, maxlength: 12,
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
              placeholder: "123456789012" %>
        <% end %>

        <%= field_wrapper form, :ogrn, "ОГРНИП / ОГРН" do %>
          <%= form.text_field :ogrn, maxlength: 15,
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
              placeholder: "ОГРНИП / ОГРН" %>
        <% end %>

        <%= field_wrapper form, :okpo, "ОКПО" do %>
          <%= form.text_field :okpo, maxlength: 10,
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
        <% end %>

        <%= field_wrapper form, :okved, "ОКВЭД (основной)" do %>
          <%= form.text_field :okved,
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
              placeholder: "43.32" %>
        <% end %>
      </div>

      <%= field_wrapper form, :registration_address, "Адрес регистрации (по паспорту)" do %>
        <%= form.text_area :registration_address, rows: 2,
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
      <% end %>
    <% end %>
  </div>

  <!-- ЮРЛИЦО: организация -->
  <div data-client-type-target="legalEntityFields">
    <%= form_section "Организация" do %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <%= field_wrapper form, :short_name, "Сокращённое наименование" do %>
          <%= form.text_field :short_name,
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
              placeholder: "ООО «Ромашка»" %>
        <% end %>

        <%= field_wrapper form, :kpp, "КПП (9 цифр)" do %>
          <%= form.text_field :kpp, maxlength: 9,
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
              placeholder: "123456789" %>
        <% end %>

        <%= field_wrapper form, :director_position, "Должность руководителя" do %>
          <%= form.text_field :director_position,
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
              placeholder: "Генеральный директор" %>
        <% end %>

        <%= field_wrapper form, :director_name, "ФИО руководителя" do %>
          <%= form.text_field :director_name,
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
              placeholder: "Иванов Иван Иванович" %>
        <% end %>
      </div>

      <%= field_wrapper form, :address, "Юридический адрес (ЕГРЮЛ)" do %>
        <%= form.text_area :address, rows: 2,
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
      <% end %>
    <% end %>
  </div>

  <!-- ИП / ЮРЛИЦО: банк -->
  <div data-client-type-target="bankFields">
    <%= form_section "Банковские реквизиты" do %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <%= field_wrapper form, :bank_account, "Расчётный счёт (20 цифр)" do %>
          <%= form.text_field :bank_account, maxlength: 20,
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
        <% end %>

        <%= field_wrapper form, :bank_name, "Наименование банка" do %>
          <%= form.text_field :bank_name,
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
              placeholder: "ПАО Сбербанк" %>
        <% end %>

        <%= field_wrapper form, :bank_bik, "БИК (9 цифр)" do %>
          <%= form.text_field :bank_bik, maxlength: 9,
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
        <% end %>

        <%= field_wrapper form, :bank_corr_account, "Корр. счёт (20 цифр)" do %>
          <%= form.text_field :bank_corr_account, maxlength: 20,
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="flex items-center justify-end space-x-3 pt-4 border-t border-gray-100">
    <%= link_to "Отмена", clients_path, class: "px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-800 bg-gray-100 hover:bg-gray-200 rounded-lg transition" %>
    <%= form.submit (client.persisted? ? "Сохранить изменения" : "Создать"), class: "px-6 py-2 bg-orange-600 hover:bg-orange-500 text-white text-sm font-medium rounded-lg transition cursor-pointer shadow-sm" %>
  </div>
<% end %>
