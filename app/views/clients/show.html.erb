<% content_for :title, "Клиент «#{@client.name}»" %>

<div class="w-full">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Клиент</h1>
      <p class="text-sm text-gray-500 mt-1"><%= @client.name %></p>
    </div>
    <div class="flex space-x-2">
      <%= link_to "Изменить", edit_client_path(@client), class: "rounded-lg px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white text-sm font-medium transition shadow-sm" %>
      <%= button_to "Удалить", @client, method: :delete, class: "rounded-lg px-4 py-2 bg-red-600 hover:bg-red-500 text-white text-sm font-medium transition cursor-pointer", data: { turbo_confirm: "Удалить клиента «#{@client.name}»?" } %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <dl class="divide-y divide-gray-100">
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm font-medium text-gray-500">Имя / Название</dt>
        <dd class="text-sm text-gray-900 font-medium"><%= @client.name %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm font-medium text-gray-500">Тип</dt>
        <dd class="text-sm text-gray-900"><%= client_type_badge(@client.client_type) %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm font-medium text-gray-500">Телефон</dt>
        <dd class="text-sm text-gray-900"><%= @client.phone %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm font-medium text-gray-500">Email</dt>
        <dd class="text-sm text-gray-900"><%= @client.email.presence || "—" %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm font-medium text-gray-500">ИНН</dt>
        <dd class="text-sm text-gray-900"><%= @client.inn.presence || "—" %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm font-medium text-gray-500">КПП</dt>
        <dd class="text-sm text-gray-900"><%= @client.kpp.presence || "—" %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm font-medium text-gray-500">Адрес</dt>
        <dd class="text-sm text-gray-900"><%= @client.address.presence || "—" %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm font-medium text-gray-500">Создан</dt>
        <dd class="text-sm text-gray-900"><%= l(@client.created_at, format: :long) if @client.created_at %></dd>
      </div>
    </dl>
  </div>

  <div class="mt-6">
    <%= link_to "Назад к клиентам", clients_path, class: "rounded-lg px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium transition" %>
  </div>
</div>
