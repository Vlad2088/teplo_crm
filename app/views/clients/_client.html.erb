<tr id="<%= dom_id client %>" class="hover:bg-gray-50 transition-colors">
  <td class="px-6 py-3.5 whitespace-nowrap font-medium text-gray-900">
    <%= link_to client.name, client, class: "text-orange-600 hover:text-orange-700 hover:underline" %>
  </td>
  <td class="px-6 py-3.5 whitespace-nowrap text-gray-600"><%= client.phone %></td>
  <td class="px-6 py-3.5 whitespace-nowrap text-gray-600"><%= client.email.presence || "—" %></td>
  <td class="px-6 py-3.5 whitespace-nowrap"><%= client_type_badge(client.client_type) %></td>
  <td class="px-6 py-3.5 whitespace-nowrap text-gray-500 text-sm">
    <%= l(client.created_at, format: :short) if client.created_at %>
  </td>
  <td class="px-6 py-3.5 whitespace-nowrap text-right">
    <div class="flex justify-end space-x-2">
      <%= link_to "Просмотр", client, class: "px-2.5 py-1.5 text-xs font-medium rounded bg-gray-100 text-gray-600 hover:bg-gray-200 transition" %>
      <%= link_to "Изменить", edit_client_path(client), class: "px-2.5 py-1.5 text-xs font-medium rounded bg-orange-50 text-orange-600 hover:bg-orange-100 transition" %>
      <%= button_to "Удалить", client, method: :delete,
          class: "px-2.5 py-1.5 text-xs font-medium rounded bg-red-50 text-red-600 hover:bg-red-100 transition cursor-pointer",
          data: { turbo_confirm: "Удалить клиента «#{client.name}»?" } %>
    </div>
  </td>
</tr>
