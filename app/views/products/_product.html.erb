<div id="<%= dom_id product %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= product.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Sku:</strong>
    <%= product.sku %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Category:</strong>
    <%= product.category %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Brand:</strong>
    <%= product.brand %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Unit:</strong>
    <%= product.unit %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Purchase price:</strong>
    <%= product.purchase_price %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Sale price:</strong>
    <%= product.sale_price %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Stock quantity:</strong>
    <%= product.stock_quantity %>
  </div>
</div>
