<tr id="<%= dom_id product %>" class="hover:bg-gray-50 transition-colors">
  <td class="px-6 py-3.5 whitespace-nowrap font-medium text-gray-900">
    <%= link_to product.name, product, class: "text-orange-600 hover:text-orange-700 hover:underline" %>
  </td>
  <td class="px-6 py-3.5 whitespace-nowrap text-gray-500 font-mono text-xs"><%= product.sku %></td>
  <td class="px-6 py-3.5 whitespace-nowrap"><%= product_category_badge(product.category) %></td>
  <td class="px-6 py-3.5 whitespace-nowrap"><%= product_brand_badge(product.brand) %></td>
  <td class="px-6 py-3.5 whitespace-nowrap text-gray-600"><%= product.unit %></td>
  <td class="px-6 py-3.5 whitespace-nowrap text-gray-600"><%= format_currency(product.sale_price) %></td>
  <td class="px-6 py-3.5 whitespace-nowrap">
    <span class="<%= product.stock_quantity > 0 ? 'text-green-700' : 'text-red-500' %>"><%= product.stock_quantity %></span>
  </td>
  <td class="px-6 py-3.5 whitespace-nowrap text-right">
    <div class="flex justify-end space-x-2">
      <%= link_to "Просмотр", product, class: "px-2.5 py-1.5 text-xs font-medium rounded bg-gray-100 text-gray-600 hover:bg-gray-200 transition" %>
      <%= link_to "Изменить", edit_product_path(product), class: "px-2.5 py-1.5 text-xs font-medium rounded bg-orange-50 text-orange-600 hover:bg-orange-100 transition" %>
      <%= button_to "Удалить", product, method: :delete,
          class: "px-2.5 py-1.5 text-xs font-medium rounded bg-red-50 text-red-600 hover:bg-red-100 transition cursor-pointer",
          data: { turbo_confirm: "Удалить товар «#{product.name}»?" } %>
    </div>
  </td>
</tr>
