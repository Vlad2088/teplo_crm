<%= form_with(model: product) do |form| %>
  <% if product.errors.any? %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
      <h3 class="text-red-800 font-semibold mb-2"><%= ru_pluralize(product.errors.count, "ошибка", "ошибки", "ошибок") %>:</h3>
      <ul class="list-disc ml-6 text-red-700 text-sm">
        <% product.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_section "Основная информация" do %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <%= field_wrapper form, :name, "Название *" do %>
        <%= form.text_field :name,
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
            placeholder: "Тёплый пол XL Pipe 150 Вт" %>
      <% end %>

      <%= field_wrapper form, :sku, "Артикул *" do %>
        <%= form.text_field :sku,
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
            placeholder: "XLP-150-10" %>
      <% end %>

      <%= field_wrapper form, :category, "Категория *" do %>
        <%= form.select :category,
            { "Тёплый пол" => "warm_floor", "Терморегулятор" => "thermostat", "Подложка" => "underlay", "Прочее" => "other" },
            { include_blank: "Выберите категорию..." },
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
      <% end %>

      <%= field_wrapper form, :brand, "Бренд *" do %>
        <%= form.select :brand,
            { "Tesla" => "tesla", "XL Pipe" => "xl_pipe", "Другое" => "other_brand" },
            { include_blank: "Выберите бренд..." },
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
      <% end %>

      <%= field_wrapper form, :unit, "Единица измерения *" do %>
        <%= form.text_field :unit,
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
            placeholder: "м², шт, рулон" %>
      <% end %>

      <%= field_wrapper form, :stock_quantity, "Количество на складе" do %>
        <%= form.number_field :stock_quantity, step: 1,
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
            placeholder: "0" %>
      <% end %>
    </div>
  <% end %>

  <%= form_section "Цены" do %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <%= field_wrapper form, :sale_price, "Цена продажи *" do %>
        <%= form.number_field :sale_price, step: 0.01,
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
            placeholder: "1250.00" %>
      <% end %>

      <%= field_wrapper form, :purchase_price, "Закупочная цена" do %>
        <%= form.number_field :purchase_price, step: 0.01,
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
            placeholder: "950.00" %>
      <% end %>
    </div>
  <% end %>

  <div class="flex items-center justify-end space-x-3 pt-4 border-t border-gray-100">
    <%= link_to "Отмена", products_path, class: "px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-800 bg-gray-100 hover:bg-gray-200 rounded-lg transition" %>
    <%= form.submit "Создать", class: "px-6 py-2 bg-orange-600 hover:bg-orange-500 text-white text-sm font-medium rounded-lg transition cursor-pointer shadow-sm" %>
  </div>
<% end %>
