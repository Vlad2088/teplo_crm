<% content_for :title, "Товар «#{@product.name}»" %>

<div class="w-full">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Товар</h1>
      <p class="text-sm text-gray-500 mt-1"><%= @product.name %></p>
    </div>
    <div class="flex space-x-2">
      <%= link_to "Изменить", edit_product_path(@product), class: "rounded-lg px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white text-sm font-medium transition shadow-sm" %>
      <%= button_to "Удалить", @product, method: :delete, class: "rounded-lg px-4 py-2 bg-red-600 hover:bg-red-500 text-white text-sm font-medium transition cursor-pointer", data: { turbo_confirm: "Удалить товар «#{@product.name}»?" } %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <dl class="divide-y divide-gray-100">
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm font-medium text-gray-500">Название</dt>
        <dd class="text-sm text-gray-900 font-medium"><%= @product.name %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm font-medium text-gray-500">Артикул</dt>
        <dd class="text-sm text-gray-900 font-mono"><%= @product.sku %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm font-medium text-gray-500">Категория</dt>
        <dd class="text-sm text-gray-900"><%= product_category_badge(@product.category) %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm font-medium text-gray-500">Бренд</dt>
        <dd class="text-sm text-gray-900"><%= product_brand_badge(@product.brand) %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm font-medium text-gray-500">Единица измерения</dt>
        <dd class="text-sm text-gray-900"><%= @product.unit %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm font-medium text-gray-500">Цена продажи</dt>
        <dd class="text-sm text-gray-900"><%= format_currency(@product.sale_price) %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm font-medium text-gray-500">Закупочная цена</dt>
        <dd class="text-sm text-gray-900"><%= @product.purchase_price ? format_currency(@product.purchase_price) : "—" %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm font-medium text-gray-500">На складе</dt>
        <dd class="text-sm <%= @product.stock_quantity > 0 ? 'text-green-700' : 'text-red-500' %>"><%= @product.stock_quantity %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm font-medium text-gray-500">Создан</dt>
        <dd class="text-sm text-gray-900"><%= l(@product.created_at, format: :long) if @product.created_at %></dd>
      </div>
    </dl>
  </div>

  <div class="mt-6">
    <%= link_to "Назад к товарам", products_path, class: "rounded-lg px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium transition" %>
  </div>
</div>
