<% content_for :title, "Вход" %>

<div class="flex items-center justify-center py-10">
  <div class="w-full max-w-md">
    <!-- Логотип -->
    <div class="text-center mb-8">
      <span class="text-3xl font-bold text-orange-600">TeploCRM</span>
      <p class="text-sm text-gray-500 mt-2">Система учёта тёплых полов</p>
    </div>

    <!-- Карточка формы -->
    <div class="bg-white rounded-xl shadow-md border border-gray-200 p-8">
      <h1 class="text-xl font-bold text-gray-900 mb-6 text-center">Вход в систему</h1>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="space-y-5">
          <div>
            <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email",
                  placeholder: "you@example.com",
                  class: "w-full rounded-lg border border-gray-300 px-3.5 py-2.5 text-sm placeholder:text-gray-400 focus:border-orange-500 focus:ring-2 focus:ring-orange-500 focus:outline-none transition" %>
          </div>

          <div>
            <%= f.label :password, "Пароль", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
            <%= f.password_field :password, autocomplete: "current-password",
                  placeholder: "••••••••",
                  class: "w-full rounded-lg border border-gray-300 px-3.5 py-2.5 text-sm placeholder:text-gray-400 focus:border-orange-500 focus:ring-2 focus:ring-orange-500 focus:outline-none transition" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <label class="flex items-center gap-2 text-sm text-gray-600 select-none cursor-pointer">
              <%= f.check_box :remember_me, class: "rounded border-gray-300 text-orange-600 focus:ring-orange-500" %>
              Запомнить меня
            </label>
          <% end %>

          <%= f.submit "Войти", class: "w-full rounded-lg px-4 py-2.5 bg-orange-600 hover:bg-orange-500 text-white text-sm font-medium transition shadow-sm cursor-pointer" %>
        </div>
      <% end %>
    </div>

    <p class="text-center text-xs text-gray-400 mt-6">
      Доступ только для сотрудников компании
    </p>
  </div>
</div>
