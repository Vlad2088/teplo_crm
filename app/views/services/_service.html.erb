<div id="<%= dom_id service %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= service.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Price per sqm:</strong>
    <%= service.price_per_sqm %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= service.description %>
  </div>
</div>
