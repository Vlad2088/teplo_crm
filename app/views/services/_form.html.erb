<%= form_with(model: service) do |form| %>
  <% if service.errors.any? %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
      <h3 class="text-red-800 font-semibold mb-2"><%= pluralize(service.errors.count, "ошибка", "ошибки", "ошибок") %>:</h3>
      <ul class="list-disc ml-6 text-red-700 text-sm">
        <% service.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_section "Основная информация" do %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <%= field_wrapper form, :name, "Название *" do %>
        <%= form.text_field :name,
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
            placeholder: "Например: Монтаж тёплого пола" %>
      <% end %>

      <%= field_wrapper form, :price_per_sqm, "Цена за м² *" do %>
        <%= form.text_field :price_per_sqm,
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
            placeholder: "500" %>
      <% end %>
    </div>

    <%= field_wrapper form, :description, "Описание" do %>
      <%= form.text_area :description, rows: 4,
          class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
          placeholder: "Что входит в услугу" %>
    <% end %>
  <% end %>

  <div class="flex items-center gap-3">
    <%= form.submit (service.persisted? ? "Сохранить изменения" : "Создать"), class: "px-6 py-2 bg-orange-600 hover:bg-orange-500 text-white text-sm font-medium rounded-lg transition cursor-pointer shadow-sm" %>
  </div>
<% end %>
