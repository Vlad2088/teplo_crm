<div id="<%= dom_id order %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Client:</strong>
    <%= order.client_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= order.status %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Address:</strong>
    <%= order.address %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Area sqm:</strong>
    <%= order.area_sqm %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Measurement date:</strong>
    <%= order.measurement_date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Notes:</strong>
    <%= order.notes %>
  </div>
  <div>
    <strong class="block font-medium mb-1">User:</strong>
    <%= order.user_id %>
  </div>
</div>
