<%= form_with(model: order) do |form| %>
  <% if order.errors.any? %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
      <h3 class="text-red-800 font-semibold mb-2"><%= pluralize(order.errors.count, "ошибка", "ошибки", "ошибок") %>:</h3>
      <ul class="list-disc ml-6 text-red-700 text-sm">
        <% order.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_section "Основная информация" do %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <%= field_wrapper form, :client_id, "Клиент *" do %>
        <%= form.collection_select :client_id, Client.order(:name), :id, :name,
            { include_blank: "Выберите клиента..." },
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
      <% end %>

      <%= field_wrapper form, :status, "Статус *" do %>
        <%= form.select :status,
            order_status_options,
            {},
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
      <% end %>

      <%= field_wrapper form, :area_sqm, "Площадь (м²)" do %>
        <%= form.number_field :area_sqm, step: 0.01,
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
            placeholder: "100.5" %>
      <% end %>

      <%= field_wrapper form, :measurement_date, "Дата замера" do %>
        <%= form.date_field :measurement_date,
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
      <% end %>
    </div>
  <% end %>

  <%= form_section "Адрес и примечания" do %>
    <%= field_wrapper form, :address, "Адрес *" do %>
      <%= form.text_area :address, rows: 2,
          class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
          placeholder: "Город, улица, дом, квартира" %>
    <% end %>

    <%= field_wrapper form, :notes, "Примечания" do %>
      <%= form.text_area :notes, rows: 3,
          class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
          placeholder: "Дополнительная информация по заказу..." %>
    <% end %>

    <%= form.hidden_field :user_id, value: current_user.id %>
  <% end %>

  <div class="flex items-center justify-end space-x-3 pt-4 border-t border-gray-100">
    <%= link_to "Отмена", orders_path, class: "px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-800 bg-gray-100 hover:bg-gray-200 rounded-lg transition" %>
    <%= form.submit "Создать", class: "px-6 py-2 bg-orange-600 hover:bg-orange-500 text-white text-sm font-medium rounded-lg transition cursor-pointer shadow-sm" %>
  </div>
<% end %>
