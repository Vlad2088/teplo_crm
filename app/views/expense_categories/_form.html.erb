<%= form_with(model: expense_category, class: "contents") do |form| %>
  <% if expense_category.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg p-4 mb-5">
      <h2 class="text-sm font-semibold mb-2"><%= ru_pluralize(expense_category.errors.count, "ошибка", "ошибки", "ошибок") %> при сохранении:</h2>
      <ul class="list-disc ml-6 text-sm">
        <% expense_category.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_section("Данные статьи") do %>
    <%= field_wrapper(form, :name, "Название") do %>
      <%= form.text_field :name, required: true,
          class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-orange-500 focus:ring-orange-500" %>
    <% end %>
  <% end %>

  <div class="flex items-center gap-3">
    <%= form.submit "Сохранить", class: "rounded-lg px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white text-sm font-medium transition shadow-sm cursor-pointer" %>
    <%= link_to "Отмена", expense_categories_path, class: "rounded-lg px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium transition" %>
  </div>
<% end %>
