<%= form_with model: organization do |f| %>
  <% if organization.errors.any? %>
    <div class="m-5 p-4 bg-red-50 border border-red-200 rounded-lg">
      <h3 class="text-red-800 font-semibold mb-2"><%= ru_pluralize(organization.errors.count, "ошибка", "ошибки", "ошибок") %>:</h3>
      <ul class="list-disc ml-6 text-red-700 text-sm">
        <% organization.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="p-6 space-y-5">
    <%= form_section "Основное" do %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <%= field_wrapper f, :company_type, "Статус *" do %>
          <%= f.select :company_type,
              { "Индивидуальный предприниматель" => "individual_enterpreneur", "Юридическое лицо" => "legal_entity" },
              {},
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
              data: { company_type_target: "typeSelect", action: "company-type#typeChanged" } %>
        <% end %>

        <%= field_wrapper f, :name, "Наименование (полное) *" do %>
          <%= f.text_field :name, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
              placeholder: "ИП Иванов Иван Иванович / ООО Ромашка" %>
        <% end %>

        <div data-company-type-block="short_name">
          <%= field_wrapper f, :short_name, "Сокращённое наименование" do %>
            <%= f.text_field :short_name, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
                placeholder: "ООО «Ромашка»" %>
          <% end %>
        </div>

        <div data-company-type-block="position">
          <%= field_wrapper f, :position_title, "Должность руководителя" do %>
            <%= f.text_field :position_title, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
                placeholder: "Генеральный директор" %>
          <% end %>
        </div>

        <%= field_wrapper f, :director_name, "ФИО (для подписи)" do %>
          <%= f.text_field :director_name, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
              placeholder: "Иванов Иван Иванович" %>
        <% end %>

        <%= field_wrapper f, :inn, "ИНН *" do %>
          <%= f.text_field :inn, maxlength: 12, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
        <% end %>

        <div data-company-type-block="kpp">
          <%= field_wrapper f, :kpp, "КПП (9 цифр)" do %>
            <%= f.text_field :kpp, maxlength: 9, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
          <% end %>
        </div>

        <%= field_wrapper f, :ogrn, "ОГРНИП" do %>
          <%= f.text_field :ogrn, maxlength: 15, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
        <% end %>

        <%= field_wrapper f, :okpo, "ОКПО" do %>
          <%= f.text_field :okpo, maxlength: 10, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
        <% end %>

        <%= field_wrapper f, :okved, "ОКВЭД (основной)" do %>
          <%= f.text_field :okved, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
              placeholder: "43.32" %>
        <% end %>

        <%= field_wrapper f, :phone, "Телефон" do %>
          <%= f.text_field :phone, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
              placeholder: "+7 (999) 123-45-67" %>
        <% end %>

        <%= field_wrapper f, :email, "Email" do %>
          <%= f.text_field :email, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
        <% end %>

        <%= field_wrapper f, :address, "Адрес" do %>
          <%= f.text_field :address, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
        <% end %>
      </div>
    <% end %>

    <%= form_section "Банковские реквизиты" do %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <%= field_wrapper f, :bank_name, "Банк" do %>
          <%= f.text_field :bank_name, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm",
              placeholder: "ПАО Сбербанк" %>
        <% end %>
        <%= field_wrapper f, :bank_bik, "БИК (9 цифр)" do %>
          <%= f.text_field :bank_bik, maxlength: 9, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
        <% end %>
        <%= field_wrapper f, :bank_account, "Расчётный счёт (20 цифр)" do %>
          <%= f.text_field :bank_account, maxlength: 20, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
        <% end %>
        <%= field_wrapper f, :bank_corr_account, "Корр. счёт (20 цифр)" do %>
          <%= f.text_field :bank_corr_account, maxlength: 20, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500 text-sm" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="px-6 pb-6 flex justify-end gap-3">
    <%= f.submit organization.persisted? ? "Сохранить" : "Создать", class: "px-6 py-2 bg-orange-600 hover:bg-orange-500 text-white text-sm font-medium rounded-lg transition cursor-pointer shadow-sm" %>
  </div>
<% end %>
