<% content_for :title, "Редактирование организации" %>

<div class="w-full max-w-3xl" data-controller="company-type">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Реквизиты организации</h1>
      <p class="text-sm text-gray-500 mt-1"><%= @organization.name %></p>
    </div>
  </div>

  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-700 font-medium rounded-md inline-block"><%= notice %></p>
  <% end %>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <%= render "form", organization: @organization %>
  </div>

  <div class="mt-4">
    <%= link_to "Вернуться к организациям", organizations_path, class: "text-sm text-orange-600 hover:text-orange-500 font-medium" %>
  </div>
</div>
