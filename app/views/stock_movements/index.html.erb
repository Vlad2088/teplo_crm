<% content_for :title, "Склад" %>

<div class="w-full">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Склад</h1>
      <p class="text-sm text-gray-500 mt-1"><%= @stock_movements.count %> записей</p>
    </div>
    <%= link_to "Добавить движение", new_stock_movement_path, class: "rounded-lg px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white text-sm font-medium transition shadow-sm" %>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <% if @stock_movements.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Тип</th>
              <th class="px-6 py-3.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Товар</th>
              <th class="px-6 py-3.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Количество</th>
              <th class="px-6 py-3.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Создано</th>
              <th class="px-6 py-3.5 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Действия</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-100">
            <%= render @stock_movements %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="p-12 text-center">
        <p class="text-gray-400 text-lg mb-2">Нет движений</p>
        <p class="text-gray-400 text-sm">Добавьте первое движение по складу, чтобы начать работу</p>
        <%= link_to "Добавить движение", new_stock_movement_path, class: "mt-4 inline-block rounded-md px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white text-sm font-medium" %>
      </div>
    <% end %>
  </div>
</div>
