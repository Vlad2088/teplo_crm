<tr id="<%= dom_id stock_movement %>" class="hover:bg-gray-50 transition-colors">
  <td class="px-6 py-3.5 whitespace-nowrap"><%= movement_type_badge(stock_movement.movement_type) %></td>
  <td class="px-6 py-3.5 whitespace-nowrap text-gray-600"><%= stock_movement.product&.name || stock_movement.product_id %></td>
  <td class="px-6 py-3.5 whitespace-nowrap text-gray-600"><%= stock_movement.quantity_change %></td>
  <td class="px-6 py-3.5 whitespace-nowrap text-gray-600">
    <%= link_to "Заказ ##{stock_movement.order_id}", stock_movement.order, class: "text-orange-600 hover:text-orange-700 hover:underline" %>
  </td>
  <td class="px-6 py-3.5 whitespace-nowrap text-gray-500 text-sm">
    <%= l(stock_movement.created_at, format: :short) if stock_movement.created_at %>
  </td>
  <td class="px-6 py-3.5 whitespace-nowrap text-right">
    <div class="flex justify-end space-x-2">
      <%= link_to "Просмотр", stock_movement, class: "px-2.5 py-1.5 text-xs font-medium rounded bg-gray-100 text-gray-600 hover:bg-gray-200 transition" %>
      <%= link_to "Изменить", edit_stock_movement_path(stock_movement), class: "px-2.5 py-1.5 text-xs font-medium rounded bg-orange-50 text-orange-600 hover:bg-orange-100 transition" %>
      <%= button_to "Удалить", stock_movement, method: :delete,
          class: "px-2.5 py-1.5 text-xs font-medium rounded bg-red-50 text-red-600 hover:bg-red-100 transition cursor-pointer",
          data: { turbo_confirm: "Удалить движение склада?" } %>
    </div>
  </td>
</tr>
