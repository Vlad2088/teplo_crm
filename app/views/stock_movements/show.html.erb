<% content_for :title, "Движение по складу ##{@stock_movement.id}" %>

<div class="w-full">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Движение по складу</h1>
      <p class="text-sm text-gray-500 mt-1">Запись #<%= @stock_movement.id %></p>
    </div>
    <div class="flex space-x-2">
      <%= link_to "Изменить", edit_stock_movement_path(@stock_movement), class: "rounded-lg px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white text-sm font-medium transition shadow-sm" %>
      <%= button_to "Удалить", @stock_movement, method: :delete, class: "rounded-lg px-4 py-2 bg-red-600 hover:bg-red-500 text-white text-sm font-medium transition cursor-pointer", data: { turbo_confirm: "Удалить движение по складу?" } %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <dl class="divide-y divide-gray-100">
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm font-medium text-gray-500">Тип</dt>
        <dd class="text-sm text-gray-900"><%= movement_type_badge(@stock_movement.movement_type) %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm font-medium text-gray-500">Товар</dt>
        <dd class="text-sm text-gray-900"><%= link_to @stock_movement.product.name, @stock_movement.product, class: "text-orange-600 hover:text-orange-700 hover:underline" %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm font-medium text-gray-500">Заказ</dt>
        <dd class="text-sm text-gray-900">
          <% if @stock_movement.order %>
            <%= link_to "Заказ ##{@stock_movement.order.id} — #{@stock_movement.order.client&.name}", @stock_movement.order, class: "text-orange-600 hover:text-orange-700 hover:underline" %>
          <% else %>
            <span class="text-gray-400">Без заказа (приход)</span>
          <% end %>
        </dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm font-medium text-gray-500">Количество</dt>
        <dd class="text-sm text-gray-900"><%= @stock_movement.quantity_change %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm font-medium text-gray-500">Создано</dt>
        <dd class="text-sm text-gray-900"><%= l(@stock_movement.created_at, format: :long) if @stock_movement.created_at %></dd>
      </div>
    </dl>
  </div>

  <div class="mt-6">
    <%= link_to "Назад к складу", stock_movements_path, class: "rounded-lg px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium transition" %>
  </div>
</div>
