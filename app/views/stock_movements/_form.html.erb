<%= form_with(model: stock_movement, class: "contents") do |form| %>
  <% if stock_movement.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg p-4 mb-5">
      <h2 class="text-sm font-semibold mb-2"><%= ru_pluralize(stock_movement.errors.count, "ошибка", "ошибки", "ошибок") %> при сохранении:</h2>
      <ul class="list-disc ml-6 text-sm">
        <% stock_movement.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_section("Данные движения") do %>
    <%= field_wrapper(form, :movement_type, "Тип движения") do %>
      <%= form.select :movement_type,
          [["Поступление", "in"], ["Списание", "out"]],
          { include_blank: "Выберите тип" },
          class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-orange-500 focus:ring-orange-500" %>
    <% end %>

    <%= field_wrapper(form, :product_id, "Товар") do %>
      <%= form.collection_select :product_id, Product.order(:name), :id, :name,
          { include_blank: "Выберите товар" },
          class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-orange-500 focus:ring-orange-500" %>
    <% end %>

    <%= field_wrapper(form, :quantity_change, "Изменение количества") do %>
      <%= form.number_field :quantity_change, step: 1,
          class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-orange-500 focus:ring-orange-500" %>
    <% end %>

    <%= field_wrapper(form, :order_id, "Заказ (необязательно)") do %>
      <%= form.collection_select :order_id, Order.order(:id), :id, :id,
          { include_blank: "Без заказа" },
          class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-orange-500 focus:ring-orange-500" %>
    <% end %>
  <% end %>

  <div class="flex items-center gap-3">
    <%= form.submit "Сохранить", class: "rounded-lg px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white text-sm font-medium transition shadow-sm cursor-pointer" %>
    <%= link_to "Отмена", stock_movements_path, class: "rounded-lg px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium transition" %>
  </div>
<% end %>
